# FRAGMENTS (YAML anchor libraries — pre-loaded by the engine, not registry entries)
# These live under components/fragments/ and are never installed directly.
# ============================================================================
fragments:
  - name: base-anchors
    file: fragments/base-anchors.yaml
    description: Base YAML anchors for DRY configuration

  - name: blend-anchors
    file: fragments/blend-anchors.yaml
