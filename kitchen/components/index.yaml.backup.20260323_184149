  - name: service-templates
    file: fragments/service-templates.yaml
    description: Reusable service templates with merge keys

# ============================================================================
# USAGE EXAMPLES
# ============================================================================
#
# Include components in a recipe:
#   includes:
#     - components/terminal.yaml
#     - components/editors.yaml
#     - components/nginx.yaml      # subtype: service — auto-verified after install
#
# Use a bundle (composition only):
#   includes:
#     - components/ai-workstation.yaml   # subtype: bundle — engine resolves requires:
#
# Bootstrap installer (resolved first):
#   includes:
#     - components/uv-python.yaml        # subtype: bootstrap — trust prompt shown
#
# Override variables:
#   --var=port=3307
#   --var=enable_gpu=true
#
# Recipe classification (kind: field in recipe files):
#   kind: distro       — opinionated named OS  (--distro=NAME)
#   kind: pure blend   — Debian domain blend    (--blend=NAME)
#   kind: recipe       — explicit custom build  (--recipe=NAME)
#
# ============================================================================
