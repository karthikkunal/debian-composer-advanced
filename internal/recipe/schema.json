{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Debian Composer Recipe",
  "type": "object",
  "required": ["name", "kind"],
  "properties": {
    "name": {
      "type": "string",
      "description": "Unique name of the recipe"
    },
    "version": {
      "type": "string",
      "description": "Recipe version (e.g., 1.0.0)"
    },
    "description": {
      "type": "string",
      "description": "Brief description of what this recipe does"
    },
    "author": {
      "type": "string"
    },
    "license": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" }
    },
    "kind": {
      "type": "string",
      "enum": ["recipe", "distro", "blend", "persona", "component", "fragment"],
      "description": "Type of recipe file"
    },
    "includes": {
      "type": "array",
      "items": { "type": "string" }
    },
    "extends": {
      "type": "string"
    },
    "layers": {
      "type": "array",
      "items": { "type": "string" }
    },
    "dependencies": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Other recipes this recipe depends on"
    },
    "conflicts": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Recipes that cannot be installed together"
    },
    "variables": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "type": { "type": "string", "enum": ["string", "bool", "int", "choice"] },
          "default": { "type": ["string", "number", "boolean"] },
          "choices": { "type": "array", "items": { "type": "string" } },
          "description": { "type": "string" },
          "required": { "type": "boolean" }
        }
      }
    },
    "packages": {
      "type": "array",
      "items": { "type": "string" }
    },
    "categories": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "condition": { "type": "string" },
          "description": { "type": "string" },
          "install.packages": { "type": "array", "items": { "type": "string" } },
          "install.scripts": { "type": "array", "items": { "type": "string" } },
          "verify.commands": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "stacks": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "description": { "type": "string" },
          "categories": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "requirements": {
      "type": "object",
      "properties": {
        "min_ram": { "type": "integer" },
        "min_disk": { "type": "integer" },
        "min_cpu": { "type": "integer" },
        "gpu": { "type": "boolean" },
        "debian_version": { "type": "string" }
      }
    },
    "install": {
      "type": "object",
      "properties": {
        "pre": { "type": "array", "items": { "type": "string" } },
        "post": { "type": "array", "items": { "type": "string" } }
      }
    },
    "configure": {
      "type": "object",
      "properties": {
        "user_groups": { "type": "array", "items": { "type": "string" } },
        "commands": { "type": "array", "items": { "type": "string" } }
      }
    },
    "verify": {
      "type": "object",
      "properties": {
        "commands": { "type": "array", "items": { "type": "string" } }
      }
    },
    "post_install": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
